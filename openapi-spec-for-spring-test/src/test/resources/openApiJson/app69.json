{
  "openapi": "3.0.1",
  "info": {
    "title": "API for App69",
    "version": "unknown"
  },
  "paths": {
    "/owners/{name}": {
      "put": {
        "operationId": "upsertOwner",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/App69Controller.Owner"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted for review",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "200": {
            "description": "Default response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App69Controller.Owner"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{name}": {
      "put": {
        "operationId": "upsertPet",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/App69Controller.Pet"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created the pet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App69Controller.Pet"
                }
              }
            }
          },
          "204": {
            "description": "Nothing changed"
          },
          "200": {
            "description": "Default response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App69Controller.Pet"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "name": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "App69Controller.Owner": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "App69Controller.Pet": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
