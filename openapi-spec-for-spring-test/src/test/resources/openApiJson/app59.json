                  "type": "string"
                }
              }
            }
          },
          "200": {
            "description": "Default response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App59ApiResponseController.Owner"
                }
              }
            }
          }
        }
